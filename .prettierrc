{
  "trailingComma": "es5",
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "bracketSpacing": true,
  "importOrder": [
    "^(react/(.*)$)|^(react$)",
    "",
    "^(react-(.*)$)|^(react$)",
    "",
    "<THIRD_PARTY_MODULES>",
    "",
    "^types$",
    "^@/env(.*)$",
    "",
    "^@/modules/config/(.*)$",
    "^@/hooks/(.*)$",
    "",
    "^@/context/(.*)$",
    "^@/layout/(.*)$",
    "",
    "^@/components/(.*)$",
    "^@/utils/(.*)$",
    "",
    "^@/validation/(.*)$",
    "^@/assets/(.*)$",
    "",
    "^@/styles/(.*)$",
    "^(?!.*[.]css$)[./].*$",
    "",
    ".css$",
    "^[./]"
  ],
  "importOrderParserPlugins": [
    "typescript",
    "jsx",
    "decorators-legacy",
    "js"
  ],
  "plugins": [
    "@ianvs/prettier-plugin-sort-imports"
  ]
}